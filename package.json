{
	"name": "asia-stock-market-research",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"validate": "npm run check && npm run lint && npm run build",
		"prepare": "svelte-kit sync || echo ''",
